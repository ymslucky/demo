---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;

const projects = [
  {
    name: 'Holiday — 节假日日历',
    description: '一个简洁的交互式节假日日历应用。基于 Next.js 构建，支持滚轮切换月份、高亮当天日期，并针对移动端和桌面端做了响应式优化。',
    tags: ['Next.js', 'TypeScript', 'Tailwind CSS'],
    demo: 'https://holiday.meta-p.com',
    repo: 'https://github.com/ymslucky/holiday',
  },
  {
    name: 'FunctionStore — Serverless 函数仓库',
    description: '基于 Appwrite 的自托管 Serverless 函数管理平台。使用 Python 编写的云函数集合，将常用后端逻辑封装为可复用的 FaaS 工作流。',
    tags: ['Python', 'Appwrite', 'Serverless'],
    demo: null,
    repo: 'https://github.com/ymslucky/FunctionStore',
  },
  {
    name: 'DateView — 数据可视化看板',
    description: '基于 Next.js 的数据展示与雷达图可视化应用。探索 Edge Functions 与前端的结合，优化了数据获取逻辑和图表渲染性能。',
    tags: ['Next.js', 'TypeScript', 'Edge Functions'],
    demo: null,
    repo: 'https://github.com/ymslucky/DateView',
  },
  {
    name: 'FNav — 导航站',
    description: '个人定制的简洁导航网站，收录常用在线工具、开发资源和社区入口。',
    tags: ['HTML', 'CSS'],
    demo: null,
    repo: 'https://github.com/ymslucky/FNav',
  },
  {
    name: 'AutoTask-UI — 零代码桌面自动化工具',
    description: '基于 PySide6 的桌面自动化操作原型，将重复步骤抽象为可配置任务，由 PyAutoGUI 在后台精确复现。',
    tags: ['Python', 'PySide6', 'PyAutoGUI'],
    demo: null,
    repo: 'https://github.com/ymslucky/AutoTask-UI-',
  },
  {
    name: 'BitResonance',
    description: '实验性技术探索项目，探索字节级数据处理与信号共振的概念，后续补充文档。',
    tags: ['探索中'],
    demo: null,
    repo: 'https://github.com/ymslucky/BitResonance',
  },
];
---

<BaseLayout title="项目" description="ymslucky 的精选项目 — 节假日日历、Serverless 平台、数据可视化、桌面自动化工具等。">
  <h1 class="page-title">精选项目</h1>
  <p class="page-subtitle">用代码解决实际问题的产品与实验</p>

  <div class="card-grid">
    {projects.map((project) => (
      <article class="card project-card">
        <h3><a href={project.repo} target="_blank" rel="noopener noreferrer">{project.name}</a></h3>
        <p>{project.description}</p>
        <div class="tag-list">
          {project.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
        <div class="project-links">
          {project.demo && (
            <a href={project.demo} target="_blank" rel="noopener noreferrer">在线 Demo →</a>
          )}
          <a href={project.repo} target="_blank" rel="noopener noreferrer">源码 →</a>
        </div>
      </article>
    ))}
  </div>
</BaseLayout>
