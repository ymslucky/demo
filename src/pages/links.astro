---
import BaseLayout from '../layouts/BaseLayout.astro';

interface LinkItem {
  name: string;
  url: string;
  desc?: string;
  icon?: string;
}

interface LinkCategory {
  title: string;
  emoji: string;
  links: LinkItem[];
}

const categories: LinkCategory[] = [
  {
    title: '云服务商',
    emoji: '☁️',
    links: [
      { name: 'AWS', url: 'https://aws.amazon.com', desc: 'Amazon Web Services' },
      { name: 'Azure', url: 'https://azure.microsoft.com', desc: 'Microsoft Azure' },
      { name: 'Google Cloud', url: 'https://cloud.google.com', desc: 'GCP' },
      { name: '阿里云', url: 'https://www.aliyun.com', desc: 'Alibaba Cloud' },
      { name: '腾讯云', url: 'https://cloud.tencent.com', desc: 'Tencent Cloud' },
      { name: '华为云', url: 'https://www.huaweicloud.com', desc: 'HUAWEI CLOUD' },
      { name: 'Cloudflare', url: 'https://www.cloudflare.com', desc: 'Edge & Serverless' },
      { name: 'Vercel', url: 'https://vercel.com', desc: '前端部署与托管' },
    ],
  },
  {
    title: '开发资源',
    emoji: '📦',
    links: [
      { name: 'GitHub', url: 'https://github.com', desc: '全球最大代码托管平台' },
      { name: 'GitLab', url: 'https://gitlab.com', desc: 'DevOps 一体化平台' },
      { name: 'Stack Overflow', url: 'https://stackoverflow.com', desc: '程序员问答社区' },
      { name: 'MDN Web Docs', url: 'https://developer.mozilla.org', desc: 'Web 开发权威文档' },
      { name: 'npm', url: 'https://www.npmjs.com', desc: 'Node 包管理仓库' },
      { name: 'DevDocs', url: 'https://devdocs.io', desc: '离线 API 文档聚合' },
      { name: 'Can I Use', url: 'https://caniuse.com', desc: '浏览器兼容性查询' },
      { name: 'Regex101', url: 'https://regex101.com', desc: '正则表达式调试' },
    ],
  },
  {
    title: '前端框架与工具',
    emoji: '⚡',
    links: [
      { name: 'React', url: 'https://react.dev', desc: 'UI 构建库' },
      { name: 'Vue.js', url: 'https://vuejs.org', desc: '渐进式 JS 框架' },
      { name: 'Astro', url: 'https://astro.build', desc: '静态站点生成器' },
      { name: 'Next.js', url: 'https://nextjs.org', desc: 'React 全栈框架' },
      { name: 'Svelte', url: 'https://svelte.dev', desc: '编译时前端框架' },
      { name: 'Tailwind CSS', url: 'https://tailwindcss.com', desc: '原子化 CSS 框架' },
      { name: 'Vite', url: 'https://vitejs.dev', desc: '下一代前端构建工具' },
      { name: 'TypeScript', url: 'https://www.typescriptlang.org', desc: 'JS 类型超集' },
    ],
  },
  {
    title: '设计资源',
    emoji: '🎨',
    links: [
      { name: 'Figma', url: 'https://www.figma.com', desc: '在线协作设计工具' },
      { name: 'Dribbble', url: 'https://dribbble.com', desc: '设计师作品社区' },
      { name: 'Behance', url: 'https://www.behance.net', desc: '创意作品展示平台' },
      { name: 'Coolors', url: 'https://coolors.co', desc: '配色方案生成器' },
      { name: 'Unsplash', url: 'https://unsplash.com', desc: '免费高清图片' },
      { name: 'Iconfont', url: 'https://www.iconfont.cn', desc: '阿里矢量图标库' },
      { name: 'Lucide', url: 'https://lucide.dev', desc: '精美开源图标集' },
      { name: 'Google Fonts', url: 'https://fonts.google.com', desc: '免费网页字体' },
    ],
  },
  {
    title: 'AI 工具',
    emoji: '🤖',
    links: [
      { name: 'ChatGPT', url: 'https://chat.openai.com', desc: 'OpenAI 对话助手' },
      { name: 'Claude', url: 'https://claude.ai', desc: 'Anthropic AI 助手' },
      { name: 'Hugging Face', url: 'https://huggingface.co', desc: '模型与数据集社区' },
      { name: 'GitHub Copilot', url: 'https://github.com/features/copilot', desc: 'AI 编程搭档' },
      { name: 'Midjourney', url: 'https://www.midjourney.com', desc: 'AI 图像生成' },
      { name: 'Stable Diffusion', url: 'https://stability.ai', desc: '开源图像生成模型' },
    ],
  },
  {
    title: '开发者社区',
    emoji: '💬',
    links: [
      { name: 'Dev.to', url: 'https://dev.to', desc: '开发者博客社区' },
      { name: 'Hacker News', url: 'https://news.ycombinator.com', desc: '科技新闻与讨论' },
      { name: 'V2EX', url: 'https://www.v2ex.com', desc: '创意工作者社区' },
      { name: '掘金', url: 'https://juejin.cn', desc: '中文技术社区' },
      { name: 'Reddit /r/programming', url: 'https://www.reddit.com/r/programming/', desc: '编程 subreddit' },
      { name: 'Product Hunt', url: 'https://www.producthunt.com', desc: '新产品发现平台' },
    ],
  },
];
---

<BaseLayout title="导航" description="开发与设计常用网站导航 — 云服务、开发资源、前端框架、设计工具、AI 与开发者社区。">
  <h1 class="page-title">导航</h1>
  <p class="page-subtitle">收录开发与设计中常用的在线资源，持续更新中</p>

  <div class="links-categories">
    {categories.map((cat) => (
      <section class="links-category">
        <h2 class="links-category-title">
          <span class="links-emoji">{cat.emoji}</span>
          {cat.title}
        </h2>
        <div class="links-grid">
          {cat.links.map((link) => (
            <a
              href={link.url}
              class="link-card"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="link-name">{link.name}</span>
              {link.desc && <span class="link-desc">{link.desc}</span>}
              <span class="link-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</BaseLayout>
