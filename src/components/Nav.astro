---
const navItems = [
  { href: '/', label: '首页' },
  { href: '/about', label: '关于' },
  { href: '/projects', label: '项目' },
  { href: '/tools', label: '工具' },
  { href: '/links', label: '导航' },
  { href: '/contact', label: '联系' },
];

const { currentPath } = Astro.props;
const base = import.meta.env.BASE_URL; // '/demo/'
---

<header class="nav">
  <div class="nav-container">
    <a href={base} class="nav-logo">ymslucky</a>
    <nav class="nav-links" aria-label="主导航">
      {navItems.map((item) => {
        const itemPath = base + (item.href === '/' ? '' : item.href.replace(/^\//, ''));
        const isActive = currentPath === itemPath || (item.href !== '/' && currentPath.startsWith(itemPath));
        return (
          <a href={itemPath} class={`nav-link${isActive ? ' nav-link--active' : ''}`} aria-current={isActive ? 'page' : undefined}>
            {item.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
