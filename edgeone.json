{
  "$schema": "https://pages.edgeone.ai/schema/edgeone.schema.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "nodeVersion": "22.11.0",
  "agents": {
    "framework": "claude-agent-sdk",
    "externalNodeModules": ["undici"]
  },
  "sandbox": {
    "timeout": 600
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/zh/"
    },
    {
      "source": "/tools",
      "destination": "/zh/tools/"
    },
    {
      "source": "/tools/",
      "destination": "/zh/tools/"
    },
    {
      "source": "/tools/*",
      "destination": "/zh/tools/:splat"
    },
    {
      "source": "/blog",
      "destination": "/zh/blog/"
    },
    {
      "source": "/blog/",
      "destination": "/zh/blog/"
    },
    {
      "source": "/blog/*",
      "destination": "/zh/blog/:splat"
    },
    {
      "source": "/links*",
      "destination": "/zh/links/"
    },
    {
      "source": "/contact*",
      "destination": "/zh/contact/"
    }
  ],
  "headers": [
    {
      "source": "/_next/static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/feed.xml",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
