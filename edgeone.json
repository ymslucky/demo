{
  "$schema": "https://pages.edgeone.ai/schema/edgeone.schema.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "nodeVersion": "22.11.0",
  "headers": [
    {
      "source": "/_next/static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
