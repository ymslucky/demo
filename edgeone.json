{
  "$schema": "https://pages.edgeone.ai/schema/edgeone.schema.json",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": "out",
  "nodeVersion": "22.11.0",
  "redirects": [
    {
      "source": "/about",
      "destination": "/zh/about/",
      "permanent": true
    },
    {
      "source": "/projects",
      "destination": "/zh/projects/",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/zh/blog/",
      "permanent": true
    },
    {
      "source": "/blog/rate-limiter",
      "destination": "/zh/blog/rate-limiter/",
      "permanent": true
    },
    {
      "source": "/tools",
      "destination": "/zh/tools/",
      "permanent": true
    },
    {
      "source": "/tools/http-check",
      "destination": "/zh/tools/http-check/",
      "permanent": true
    },
    {
      "source": "/links",
      "destination": "/zh/links/",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/zh/contact/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_next/static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/zh/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/zh/about/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/zh/projects/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
