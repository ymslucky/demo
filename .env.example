# LuckyLab 环境变量模板
# 本地开发：复制为 .env.local（已被 git 忽略，绝不提交真实密钥）。
# 部署环境：在 EdgeOne 控制台按同名单独配置。

# Clerk 认证（Dashboard → API Keys）。ClerkProvider / clerkMiddleware 默认读取。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 站点主域名：全站唯一需要配置的域名变量——
# - todo 边缘函数鉴权：issuer = https://clerk.<域名>，azp = <域名> 及其任意子域
# - 站点对外 URL（RSS / sitemap / 元数据）：https://www.<域名>
# 接受 rdom.cn、https://rdom.cn、https://www.rdom.cn 等写法；未配置默认 rdom.cn。
SITE_DOMAIN=rdom.cn

# GitHub：首页 Contributions 展示，仅用于提升 API 配额（登录名已写死在代码中）。
GITHUB_TOKEN=
