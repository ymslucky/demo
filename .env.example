# LuckyLab 环境变量模板
# 本地开发：复制为 .env.local（已被 git 忽略，绝不提交真实密钥）。
# 部署环境：在 EdgeOne 控制台按同名单独配置。

# Clerk 认证（Dashboard → API Keys）。ClerkProvider / clerkMiddleware 默认读取。
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# 站点访问域名：todo 边缘函数的 issuer / azp 白名单由此派生
# （issuer = https://clerk.<域名>，azp = <域名> 与 www.<域名>）。
# 接受 rdom.cn、https://rdom.cn、https://www.rdom.cn 等写法。
SITE_DOMAIN=rdom.cn

# 站点对外 URL：RSS feed（app/feed.xml）中绝对链接的前缀。
NEXT_PUBLIC_SITE_URL=https://www.rdom.cn

# GitHub：首页 Contributions 展示（GITHUB_TOKEN 仅在需要提升 API 配额时配置）。
GITHUB_LOGIN=ymslucky
GITHUB_TOKEN=
